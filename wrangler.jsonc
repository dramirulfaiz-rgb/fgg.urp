{
  "name": "fgg-urp",
  "main": "worker.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fgg-urp-db",
      "database_id": "5990ed09-5af6-4fbd-853f-dfd43db34e17",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "fgg-urp-files"
    }
  ],
  "vars": {
    "PORTAL_URL": ""
  }
}
